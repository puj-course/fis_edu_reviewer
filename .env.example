# Copiar a .env (no se versiona) o definir como secretos en GitHub Actions.

# Token de GitHub (fine-grained) sobre la organización puj-course:
#   Repositorios: Contents (lectura), Issues (lectura y escritura), Pull requests (lectura),
#                 Actions (lectura), Metadata (lectura)
#   Organización: Projects (lectura)
FIS_GH_TOKEN=

# Capa de IA (DeepSeek). Sin clave, el agente funciona solo con indicadores.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Sonar (opcional). El agente lee los análisis que corre el pipeline de cada equipo; no analiza código.
# SonarCloud público funciona sin nada. Token de solo lectura para proyectos privados de SonarCloud:
FIS_SONARCLOUD_TOKEN=
# SonarQube propio del curso: URL y token de un usuario con permiso "Browse" sobre los proyectos.
FIS_SONAR_URL=
FIS_SONAR_TOKEN=
